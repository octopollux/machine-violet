{
  "name": "@machine-violet/campaign-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/index.ts & vite",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
